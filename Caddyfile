{
	http_port {$HTTP_PORT:80}
	https_port {$HTTPS_PORT:443}
	servers {
		trusted_proxies static {$TRUSTED_PROXIES:private_ranges}
	}
}

{$SITE_ADDRESS} {
	encode zstd gzip
	@fonts path /static/fonts/*
	header @fonts Cache-Control "public, max-age=604800"
	@teams path /teams/messages
	request_body @teams {
		max_size 64KB
	}
	reverse_proxy api:8000
}
