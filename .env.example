# Variables à renseigner dans l'UI Portainer (Stack > Environment variables)
DOMAIN=sound.example.org
POSTGRES_USER=sound
POSTGRES_PASSWORD=change-me
POSTGRES_DB=sound
LOG_LEVEL=INFO

# Auth (Entra ID, app mono-tenant « soundtech »)
ENTRA_TENANT_ID=<tenant-id>
ENTRA_CLIENT_ID=<client-id>
ENTRA_CLIENT_SECRET=
PUBLIC_BASE_URL=https://sound.example.org
JWT_SECRET=
BOOTSTRAP_ADMIN_EMAIL=admin@example.org

# Home Assistant (annonces TTS) ; HA_TOKEN = long-lived access token, secret
HA_URL=
HA_TOKEN=
# domaine.service ; intégration non officielle (alexa_media), donc configurable
HA_TTS_SERVICE=notify.alexa_media

# Music Assistant ; MA_TOKEN = token long durée (MA >= 2.7, secret). Sans MA_URL : routes /music -> 503
MA_URL=
MA_TOKEN=
TEST_PREFIX=Ceci est un test.

# Teams (Bot Framework) : diffusion des alertes + webhook POST /teams/messages (503 sans TEAMS_APP_ID)
TEAMS_APP_ID=
TEAMS_APP_SECRET=
TEAMS_TENANT_ID=
TEAMS_SERVICE_URL=
TEAMS_CONVERSATION_ID=
# Roster : groupe Entra des personnes attendues (permission Graph GroupMember.Read.All, application)
ROSTER_GROUP_ID=
# Rétention RGPD des réponses étudiants (jours, 0 = illimitée)
RESPONSE_RETENTION_DAYS=90
