# Variables à renseigner dans l'UI Portainer (Stack > Environment variables)
DOMAIN=sound.example.org
# Ports publiés par Caddy (HTTPS_PORT = port externe ; Let's Encrypt exige 80/443 publics sauf proxy devant)
HTTP_PORT=80
HTTPS_PORT=443
POSTGRES_USER=sound
POSTGRES_PASSWORD=change-me
POSTGRES_DB=sound
LOG_LEVEL=INFO

# Auth (Entra ID, app mono-tenant « soundtech »)
ENTRA_TENANT_ID=<tenant-id>
ENTRA_CLIENT_ID=<client-id>
ENTRA_CLIENT_SECRET=
PUBLIC_BASE_URL=https://sound.example.org
JWT_SECRET=
BOOTSTRAP_ADMIN_EMAIL=admin@example.org

# Home Assistant (annonces TTS) ; HA_TOKEN = long-lived access token, secret
HA_URL=
HA_TOKEN=
# domaine.service ; intégration non officielle (alexa_media), donc configurable
HA_TTS_SERVICE=notify.alexa_media
# Volume forcé pendant la diffusion puis restauré (0 = ne pas forcer ; 0-100). Un interrupteur par type.
ALERT_FORCE_VOLUME=true
ALERT_VOLUME=100
ANNOUNCE_FORCE_VOLUME=true
ANNOUNCE_VOLUME=100
# Restauration après durée estimée de lecture (mots/ANNOUNCE_WPM) + marge, plafonnée (secondes)
VOLUME_RESTORE_MARGIN=3
VOLUME_RESTORE_MAX_WAIT=120

# Music Assistant ; MA_TOKEN = token long durée (MA >= 2.7, secret). Sans MA_URL : routes /music -> 503
MA_URL=
MA_TOKEN=
TEST_PREFIX=Ceci est un test.

# Teams (Bot Framework) : diffusion des alertes + webhook POST /teams/messages (503 sans TEAMS_APP_ID)
TEAMS_APP_ID=
TEAMS_APP_SECRET=
TEAMS_TENANT_ID=
TEAMS_SERVICE_URL=
TEAMS_CONVERSATION_ID=
# Roster : groupe Entra des personnes attendues (permission Graph GroupMember.Read.All, application)
ROSTER_GROUP_ID=
# Rétention RGPD des réponses étudiants (jours, 0 = illimitée)
RESPONSE_RETENTION_DAYS=90

# Sauvegardes Postgres (service backup, volume `backups`) : rétention en jours (0 = illimitée), intervalle en secondes
BACKUP_RETENTION_DAYS=14
BACKUP_INTERVAL_SECONDS=86400

# Rate limits (fenêtre fixe Redis, fail-open ; 0 = désactivé). Par IP : auth, refresh, webhook Teams. Par utilisateur : annonces, musique.
# Webhook : généreux pour absorber un pic légitime de réponses (IP Microsoft partagées).
RL_WINDOW=60
RL_AUTH_LIMIT=30
RL_REFRESH_LIMIT=30
RL_ANNOUNCE_LIMIT=20
RL_MUSIC_LIMIT=120
RL_WEBHOOK_LIMIT=3000
# Derrière un reverse proxy existant qui gère le TLS (Apache, Nginx...) :
#   SITE_ADDRESS=http://sound.exemple.fr   (Caddy sert en HTTP simple, pas de redirection => évite ERR_TOO_MANY_REDIRECTS)
#   HTTP_PORT=49501                        (port vers lequel le proxy envoie)
#   TRUSTED_PROXIES="private_ranges 100.64.0.0/10"  (IP du proxy, pour lire X-Forwarded-For/Proto)
# Par défaut : SITE_ADDRESS = DOMAIN (Caddy gère le TLS Let's Encrypt lui-même).
# --- Derrière un Apache/Nginx existant (cas campus) : Caddy est INUTILE ---
# Caddy est désactivé par défaut (profil "caddy"). L'API est publiée sur l'hôte :
#   API_BIND=0.0.0.0              (défaut 127.0.0.1 ; mets l'IP du serveur joignable par le proxy)
#   API_PORT=49501
#   FORWARDED_ALLOW_IPS=<IP du proxy>   (défaut * : à restreindre, sinon X-Forwarded-For falsifiable)
# Le proxy doit envoyer X-Forwarded-For et X-Forwarded-Proto https, et terminer le TLS.
# Pour réactiver Caddy (TLS autonome) : COMPOSE_PROFILES=caddy
